FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-secret-key
# Leave DATABASE_URL blank to use backend/instance/bloc_dev.sqlite locally.
# Set it to a Postgres URL when you have Postgres running.
DATABASE_URL=
AUTO_CREATE_DB=true
API_BASE_URL=http://localhost:3000/
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MESSAGE_ENCRYPTION_KEY=
